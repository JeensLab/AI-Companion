# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# The Unix launcher must keep LF line endings on every platform.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Vendored third-party sources keep the upstream style, including its trailing whitespace and tabs:
# a whitespace-only rewrite would make every future update of the library a whole-file diff.
src/main/java/javazoom/** -whitespace
src/main/java/biniu/** -whitespace
