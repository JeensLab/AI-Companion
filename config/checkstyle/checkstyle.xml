<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  One check only: an import whose name never appears in the file is dead weight and compiles fine, so nothing else
  notices it. UnusedImports is textual, so it needs no classpath and cannot red anything unrelated to imports.
  processJavadoc keeps a type that is only mentioned in a {@link} or {@code} tag counted as used, so a javadoc
  reference is never reported for deletion.

  New rules are added here deliberately, one at a time, after checking that the existing tree passes them; importing a
  whole ruleset (Sun, Google) would fail hundreds of unrelated lines on the first run.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>
    <module name="TreeWalker">
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
    </module>
</module>
